    "banner.answeredWithoutReading" : {
      "comment" : "The beacon is on the network but answered with an error; the app or widget is showing its cache",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Beacon antwortete, lieferte aber keine Messung. Angezeigt wird die letzte von vor %1$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The beacon answered but sent no reading. Showing the last one, from %1$@ ago."
          }
        }
      }
    },
    "banner.clockUnsynced" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Uhr des Beacons wurde nie synchronisiert; alle Zeiten unten sind daher unzuverlässig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The beacon's clock has never synchronised, so every time below is unreliable."
          }
        }
      }
    },
    "banner.flashCache" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach einem Neustart aus dem Flash des Beacons wiederhergestellt, %1$@ alt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restored from the beacon's flash after a reboot, %1$@ old."
          }
        }
      }
    },
    "banner.lastKnown" : {
      "comment" : "The app or widget could not reach the beacon and is showing its cache",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beacon nicht erreichbar. Angezeigt wird die letzte Messung von vor %1$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beacon unreachable. Showing the last reading, from %1$@ ago."
          }
        }
      }
    },
    "banner.noForecast" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist keine Vorhersage eingetroffen. Das ist kein Urteil über den Himmel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No forecast has arrived. This is not a judgement about the sky."
          }
        }
      }
    },
    "banner.stale" : {
      "comment" : "Shown above the verdict when data.stale is true",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Vorhersage ist %1$@ alt. Die Wetterhälfte dieser Antwort ist veraltet; Dunkelheit und Mond sind es nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The forecast is %1$@ old. The sky half of this answer is out of date; the darkness and the Moon are not."
          }
        }
      }
    },
