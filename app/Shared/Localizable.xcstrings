    "action.fetchForecastNow" : {
      "comment" : "Triggers POST /api/v1/refresh, which costs the beacon an upstream API call",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorhersage jetzt abrufen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fetch the forecast now"
          }
        }
      }
    },
