<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Shared with the other tools of this observing season, not just with this
	     app's own widget. An App Group is per development team, so every tool
	     signed by the same team can join it; what lives there is the handful of
	     settings that belong to the observer rather than to one application —
	     night vision above all, because dark adaptation is not per-app.

	     $(LW_APP_GROUP) comes from Config/Signing.xcconfig, which spells it bare
	     for iOS and team-prefixed for macOS. One file for both platforms, and no
	     team identifier written down here. SharedStore probes for whichever group
	     was actually granted and falls back to per-process defaults if none was,
	     so this entitlement is an improvement, never a dependency. Keys are
	     namespaced `astro.` for shared and `launchWindow.` for private. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(LW_APP_GROUP)</string>
	</array>
</dict>
</plist>
